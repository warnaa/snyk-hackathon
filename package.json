{
  "name": "agent-heist",
  "version": "0.1.0",
  "private": true,
  "description": "A haunted-archive escape game that teaches AI security: prompt injection and tool authorization.",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "start": "node --experimental-strip-types --env-file-if-exists=.env src/server.ts",
    "cert": "node --experimental-strip-types scripts/make-cert.ts",
    "test": "node --experimental-strip-types --test \"test/**/*.test.ts\"",
    "reliability": "node --experimental-strip-types --env-file-if-exists=.env scripts/reliability.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
