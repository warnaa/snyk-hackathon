# Copy to .env (git-ignored). Never commit real values.

# Guild account API key as "<key id>:<secret>".
# Create with: guild api-key create --scopes "sessions:write,workspaces:read,agents:read"
GUILD_API_KEY=replace-with-key-id:replace-with-secret
# Workspace UUID that has the guardian agent installed (guild workspace get <name>)
GUILD_WORKSPACE=00000000-0000-0000-0000-000000000000
# Guardian agent UUID (guild-agent/guild.json)
GUILD_AGENT=00000000-0000-0000-0000-000000000000

PORT=3000
